# pekko-agent Environment Configuration
# 복사 후 실제 값으로 변경: cp .env.example .env

# ── LLM ──────────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096
LLM_PROVIDER=claude

# Optional: multi-provider fallback
# GOOGLE_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o

# ── Kafka (MSDS 서비스 간 메시지) ─────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── MSDS 파일 저장소 · PDF 처리 ───────────────────────────────────────────────
# 업로드 PDF·페이지 이미지를 두는 폴더 (저장소 밖 옆 폴더)
MSDS_STORAGE_DIR=../_storage
# pdfium 바이너리(libpdfium.so)가 든 폴더. bblanchon/pdfium-binaries chromium/7881
PDFIUM_LIB_DIR=../_tools/pdfium-7881/lib
# 페이지 렌더링 해상도
# MSDS_RENDER_DPI=150

# ── MSDS 에이전트 (Claude 호출) ───────────────────────────────────────────────
# live: 실제 호출(응답은 MSDS_STORAGE_DIR/llm-cache에 기록, 같은 요청은 다시 보내지 않음)
# replay: 기록된 응답만 사용, 기록이 없으면 실패 (API 비용 0)
MSDS_LLM_MODE=live
# 서비스 프로세스 하나가 켜져 있는 동안 쓸 수 있는 토큰 상한
# MSDS_TOKEN_BUDGET=2000000
# 오케스트레이터가 작업을 보낼 에이전트 (서비스가 있는 것만, 쉼표로 구분)
MSDS_AGENTS=composition
# 에이전트가 이 시간(초) 안에 답하지 않으면 한 번 다시 보낸다
# MSDS_TASK_TIMEOUT_SECS=1200

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://pekko:pekko_secret@localhost:5432/pekko_agent
POSTGRES_PASSWORD=pekko_secret

# ── Security ──────────────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 characters in production
JWT_SECRET=change-me-in-production-32-chars!!
JWT_TTL_SECONDS=3600
# Legacy env-var keys (still work; DB keys take priority on collision)
ADMIN_API_KEY=your-admin-api-key-here
AGENT_API_KEY=your-agent-api-key-here
# DB-backed keys are created via POST /api/admin/api-keys and stored hashed in pekko_api_keys

# ── Rate Limiting (requests per minute) ──────────────────────────────────────
RATE_LIMIT_ADMIN_RPM=1000
RATE_LIMIT_AGENT_RPM=300
RATE_LIMIT_DEFAULT_RPM=60

# ── Circuit Breaker ───────────────────────────────────────────────────────────
CB_MAX_FAILURES=5
CB_CALL_TIMEOUT_SECS=30
CB_RESET_TIMEOUT_SECS=60

# ── Vector Store (pgvector) ───────────────────────────────────────────────────
# Set to true if pgvector extension is not installed in PostgreSQL
# DISABLE_VECTOR_STORE=true
# Embeddings use OPENAI_API_KEY above; set EMBEDDING_MODEL to override
# EMBEDDING_MODEL=text-embedding-3-small

# ── Orchestrator Persistence ──────────────────────────────────────────────────
# Set to true for ephemeral/test environments (skips DB persistence)
# DISABLE_ORCHESTRATOR_PERSISTENCE=true

# ── Redis (response cache) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# TTL for cached LLM responses (seconds); 0 = use default (300)
CACHE_TTL_SECONDS=300
# Set to true to disable Redis caching entirely (e.g. local dev without Redis)
# DISABLE_CACHE=true

# ── Service Ports ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8080
GRPC_PORT=50051

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=info
# Enable OpenTelemetry export (Jaeger / OTLP-compatible collector)
# OTLP_ENDPOINT=http://localhost:4317
